# Copy this file to .env and fill in your own Neon addresses.
# Find them in the Neon dashboard under "Connect".
# .env is git-ignored, so your password never reaches GitHub.

# Pooled address ("Connection pooling" ON): used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct address ("Connection pooling" OFF): used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

PORT=3000
