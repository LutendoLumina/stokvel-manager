# Copy this file to .env.test and fill in your Neon "test" branch addresses.
# The e2e tests read ONLY this file, so they never touch your dev data in .env.
# .env.test is git-ignored, so your password never reaches GitHub.

# Pooled address ("Connection pooling" ON, has -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-test-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct address ("Connection pooling" OFF, no -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-test-example.region.aws.neon.tech/neondb?sslmode=require"
