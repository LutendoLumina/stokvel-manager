// Prisma schema: the "map" of our database.
// Each user story adds the tables it needs. Design: docs/design/database.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection address lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// A person who can log in (US-01).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String   @unique // always +27 format, e.g. +27821234567
  email        String? // optional: many members don't use email
  passwordHash String // never the real password
  name         String
  createdAt    DateTime @default(now())
}
